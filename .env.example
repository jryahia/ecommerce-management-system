# ============================================
# E-commerce Management System
# Root Environment Configuration Reference
# ============================================
#
# This project uses separate .env files for frontend and backend:
#
#   backend/.env   - Backend API configuration
#   frontend/.env  - Frontend configuration
#
# Each directory has a .env.example file with documentation.
# Copy each .env.example to .env and configure as needed:
#
#   cd backend && cp .env.example .env
#   cd frontend && cp .env.example .env
#
# ============================================

# Below is a quick reference for common settings.
# For detailed documentation, see the .env.example files
# in the backend and frontend directories.

# --------------------------------------------
# Database (Required)
# --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_USER=postgres
DB_PASSWORD=password

# --------------------------------------------
# Redis (Optional)
# --------------------------------------------
REDIS_URL=redis://localhost:6379

# --------------------------------------------
# JWT Secret (Required)
# --------------------------------------------
JWT_SECRET=change-this-to-a-secure-random-string

# --------------------------------------------
# Server Ports
# --------------------------------------------
# Backend: 5000
# Frontend: 3000
