# ============================================
# E-commerce Backend Configuration
# ============================================
# Copy this file to .env and update the values
# cp .env.example .env

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=development
PORT=5000

# --------------------------------------------
# PostgreSQL Database Configuration
# --------------------------------------------
# Install PostgreSQL locally or use a cloud provider
# Download: https://www.postgresql.org/download/
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_USER=postgres
DB_PASSWORD=password

# --------------------------------------------
# Redis Configuration (Optional)
# --------------------------------------------
# Redis is used for caching but is optional
# The app will work without it (caching disabled)
# Install: https://redis.io/download or use Redis Cloud
REDIS_URL=redis://localhost:6379

# Set to 'true' to disable Redis even if available
REDIS_DISABLED=false

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
# IMPORTANT: Change this to a secure random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# JWT token expiration (default: 7 days)
JWT_EXPIRES_IN=7d

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
FRONTEND_URL=http://localhost:3000

# --------------------------------------------
# File Upload Configuration
# --------------------------------------------
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
LOG_LEVEL=info

# --------------------------------------------
# Email Configuration (Optional)
# --------------------------------------------
# Used for sending notifications and password resets
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
